# iCloud credentials. The password is an app-specific password generated at
# appleid.apple.com -- not the Apple ID account password.
APPLE_ID=you@example.com
APPLE_APP_PASSWORD=abcd-efgh-ijkl-mnop

# Calendar that create_event writes to when the caller does not name one,
# by display name or id. iCloud does not publish a default of its own, so
# without this the server falls back to whichever calendar it happens to list
# first -- which changes when you add a calendar.
CALENDAR_MCP_DEFAULT_CALENDAR=Personal

# IANA zone assumed when a caller omits timeZone. Defaults to the host's zone.
# CALENDAR_MCP_TIMEZONE=America/Chicago

# --- HTTP transport (all optional; stdio is the default) ---
# CALENDAR_MCP_TRANSPORT=http
# CALENDAR_MCP_HOST=127.0.0.1
# CALENDAR_MCP_PORT=18790
# CALENDAR_MCP_STATELESS=true

# --- Authentication, HTTP transport only ---
# CALENDAR_MCP_AUTH=password
# CALENDAR_MCP_PASSWORD=a-long-random-value
# CALENDAR_MCP_BASE_URL=https://calendar.example.com
# CALENDAR_MCP_STATE_DIR=~/.calendar-mcp
